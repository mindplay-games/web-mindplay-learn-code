/* Required Script Properties: SPREADSHEET_ID (private Sheet) and TEACHER_EMAIL. */
const MAX_BODY=30000, MAX_RESULTS=25, SUBMISSIONS='Student Submissions', DETAILS='Detailed Answers', LOG='Notification Log';
function setupSheets(){const b=SpreadsheetApp.openById(required_('SPREADSHEET_ID'));ensure_(b,SUBMISSIONS,['Submission ID','Student name','Group number','Submission date','Submission time','Total score','Maximum score','Percentage','Correct answers','Incorrect answers','Total attempts','Duration (seconds)','Topics requiring improvement','Completion status']);ensure_(b,DETAILS,['Submission ID','Student name','Group number','Question ID','Question topic','Student answer','Correct answer','Correct/incorrect','Number of attempts','Score awarded']);ensure_(b,LOG,['Time','Submission ID','Status','Details']);}
function doPost(e){const lock=LockService.getScriptLock();try{lock.waitLock(10000);const raw=e&&e.postData&&e.postData.contents||'';if(!raw||raw.length>MAX_BODY)return reply_({ok:false,error:'invalid_payload'});const d=JSON.parse(raw);if(!valid_(d))return reply_({ok:false,error:'invalid_payload'});const b=SpreadsheetApp.openById(required_('SPREADSHEET_ID'));setupSheets();const main=b.getSheetByName(SUBMISSIONS);const exists=main.getLastRow()>1&&main.getRange(2,1,main.getLastRow()-1,1).getValues().flat().indexOf(d.submissionId)!==-1;if(exists)return reply_({ok:true,duplicate:true});const at=new Date(d.submittedAt);main.appendRow([safe_(d.submissionId,100),safe_(d.studentName,60),safe_(d.groupNumber,8),Utilities.formatDate(at,Session.getScriptTimeZone(),'yyyy-MM-dd'),Utilities.formatDate(at,Session.getScriptTimeZone(),'HH:mm:ss'),d.score,d.maxScore,d.percentage,d.correctAnswers,d.incorrectAnswers,d.totalAttempts,d.durationSeconds,safe_(d.topicsForImprovement.join(', '),500),safe_(d.completionStatus,40)]);const detail=b.getSheetByName(DETAILS);d.results.forEach(r=>detail.appendRow([safe_(d.submissionId,100),safe_(d.studentName,60),safe_(d.groupNumber,8),safe_(r.id,100),safe_(r.topic,100),safe_(r.answer,500),safe_(r.expected,500),r.correct?'נכון':'לא נכון',r.attempts,r.score]));try{notify_(d,b.getUrl());}catch(mailError){b.getSheetByName(LOG).appendRow([new Date(),safe_(d.submissionId,100),'email_failed',safe_(mailError.message,500)]);}return reply_({ok:true,duplicate:false});}catch(err){return reply_({ok:false,error:'server_error'});}finally{try{lock.releaseLock();}catch(_){}}}
function notify_(d,url){const body=['התקבלה הגשה חדשה במעבדת ארכיטקטורה – ממליץ הסרטים.','',`תלמיד/ה: ${safe_(d.studentName,60)}`,`קבוצה: ${safe_(d.groupNumber,8)}`,`ציון: ${d.score}/${d.maxScore} (${d.percentage}%)`,`משך: ${d.durationSeconds} שניות`,`נושאים לתרגול: ${d.topicsForImprovement.join(', ')||'אין'}`,`גיליון פרטי: ${url}`].join('\n');MailApp.sendEmail(required_('TEACHER_EMAIL'),'תרגול שנה ג׳ – הגשה חדשה',body);}
function valid_(d){return d&&typeof d.submissionId==='string'&&/^[a-zA-Z0-9-]{10,100}$/.test(d.submissionId)&&typeof d.studentName==='string'&&d.studentName.trim().split(/\s+/).length>=2&&d.studentName.length<=60&&/^\d{1,8}$/.test(String(d.groupNumber))&&Array.isArray(d.results)&&d.results.length>0&&d.results.length<=MAX_RESULTS&&Number.isInteger(d.score)&&Number.isInteger(d.maxScore)&&d.maxScore<=MAX_RESULTS&&Number.isInteger(d.percentage)&&d.percentage>=0&&d.percentage<=100&&Number.isInteger(d.totalAttempts)&&d.totalAttempts<=1000;}
function safe_(v,max){return String(v==null?'':v).replace(/^[=+\-@]/,"'$&").replace(/[\u0000-\u001F]/g,' ').slice(0,max);}
function required_(n){const v=PropertiesService.getScriptProperties().getProperty(n);if(!v)throw new Error(`Missing Script Property: ${n}`);return v;}
function ensure_(b,n,h){let s=b.getSheetByName(n);if(!s)s=b.insertSheet(n);if(s.getLastRow()===0){s.appendRow(h);s.setFrozenRows(1);s.getRange(1,1,1,h.length).setFontWeight('bold');}return s;}
function reply_(d){return ContentService.createTextOutput(JSON.stringify(d)).setMimeType(ContentService.MimeType.JSON);}
